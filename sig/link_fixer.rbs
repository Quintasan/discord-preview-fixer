class LinkFixer
  HTTP_REGEX: Regexp

  TRAILING_PUNCTUATION: Regexp

  SPOILER: String

  @message: String

  @spoiler_spans: Array[Range[Integer]]

  @code_spans: Array[Range[Integer]]

  def self.fix: (untyped message) -> Array[String]

  def initialize: (untyped message) -> void

  def fix: () -> Array[String]

  private

  def extract_links: () -> Array[[URI::Generic, bool]]

  def fix_uri: (URI::Generic uri) -> String?

  def deduplicate: (Array[[String, bool]] links) -> Array[[String, bool]]

  def inside_spoiler?: (Integer offset) -> bool

  def inside_code?: (Integer offset) -> bool

  def spoiler_spans: () -> Array[Range[Integer]]

  def spoiler_marker: (Integer from) -> Integer?

  def code_spans: () -> Array[Range[Integer]]

  def append_span: (Array[Range[Integer]] ranges, Integer open, String delimiter) -> Integer
end
